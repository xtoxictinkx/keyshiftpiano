{
  "name": "key-shift-piano",
  "version": "0.1.0",
  "description": "A local desktop app for transposing piano MusicXML files.",
  "main": "src/main/main.js",
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test:js": "node --test tests/*.test.js",
    "test:python": "python -m unittest discover -s tests",
    "build:engine": "pyinstaller --onefile --name transposer --distpath python/dist python/transposer.py",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.keyshiftpiano.app",
    "productName": "Key Shift Piano",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "python/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "python",
        "to": "python"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
